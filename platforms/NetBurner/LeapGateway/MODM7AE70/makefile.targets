ifeq ($(MKNBLIBS),1)
all: $(TARGET)
$(ELF): $(TARGET)
endif

ifeq ($(NBDEBUG),1)
$(TARGET): $(DBLIB_OBJ_FILES)
else
$(TARGET): $(LIB_OBJ_FILES)
endif
	$(RM) $@
	$(call max_args,$(AR) cr $@ ,10,$^)

.PHONY: clean-nblibs load-nbimage app-s19

clean-nblibs:
	$(RM) $(OBJDIR)

# Legacy AutoUpdate image (*_APP.s19) for first-time flash. Run from Release after build.
ifneq ($(strip $(BUILD_ARTIFACT_NAME)),)
app-s19: $(BUILD_ARTIFACT_NAME).s19
	@echo 'Building AutoUpdate image: $(BUILD_ARTIFACT_NAME)_APP.s19'
	compcode $< $(BUILD_ARTIFACT_NAME)_APP.s19 0xC0040000 0xC1FC0000 -P$(PLATFORM) -R -M $(BUILD_ARTIFACT_NAME).map
endif

load-nbimage:
	@echo "Sending $(NBIMAGE) to $(DEVIP)"
	$(APPUPDATE) -q -O- --post-file=$(NBIMAGE) $(DEVIP):20034/appupdate.htm

htmldata.cpp: $(COMPHTML_SRCS)
	comphtml $(HTMLDIR) -o$@

htmldata.o: htmldata.cpp
	arm-unknown-eabi-g++ -c -I"../src" $(CXXFLAGS) $(CPPFLAGS) $(EXTRACPPFLAGS) $< -o $@

ifneq ($(wildcard $(OBJDIR)/.stale),)
clean: clean-nblibs
endif

ifneq ($(strip $(ELF)),)
.SECONDEXPANSION:
ELF1 := $(firstword $(ELF))
TIMESTAMP_SRC = "extern const char LinkTime[]; const char LinkTime[] = \"`date -u +"%Y-%m-%dT%H:%M:%SZ"`\";"
LINKSTAMP_OBJ := $(dir $(ELF1))$(notdir $(basename $(ELF1)))_linkDTStamp.o
USER_OBJS += $(LINKSTAMP_OBJ)
$(ELF1): $(LINKSTAMP_OBJ)

$(LINKSTAMP_OBJ): $$(filter-out $$(LINKSTAMP_OBJ),$$(OBJS) $$(USER_OBJS)) $$(LIBS) makefile objects.mk sources.mk subdir.mk
	@echo "Time stamping $@"
	@mkdir -p $(dir $@)
	@echo $(TIMESTAMP_SRC) | arm-unknown-eabi-g++ $(CPPFLAGS) $(CXXFLAGS) $(EXTRACPPFLAGS) -o $@ -xc++ -c -
endif

# Eclipse-generated subdir.mk compile lines omit LEAP gateway include paths.
# Explicit rules here override those pattern rules (included last via Release/makefile).
GW_APP_CXX_BASE := -std=gnu++17 -O2 -Wall -c -fmessage-length=0 -fdata-sections -fno-use-cxa-atexit -ffunction-sections \
	-gdwarf-2 -fno-exceptions -fno-rtti -Wno-write-strings -falign-functions=4 -fasynchronous-unwind-tables \
	-mcpu=cortex-m7 -DMODM7AE70 -DSAME70 -DCORTEX_M7 -mfpu=fpv5-d16 -mfloat-abi=softfp -mthumb

GW_APP_C_BASE := -std=gnu11 -O2 -Wall -c -fmessage-length=0 -fdata-sections -ffunction-sections \
	-gdwarf-2 -Wno-write-strings -falign-functions=4 -fasynchronous-unwind-tables \
	-mcpu=cortex-m7 -DMODM7AE70 -DSAME70 -DCORTEX_M7 -mfpu=fpv5-d16 -mfloat-abi=softfp -mthumb

./src/main.o: ../src/main.cpp
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C++ Compiler'
	arm-unknown-eabi-g++ $(GW_APP_CXX_BASE) $(CXXFLAGS) $(CPPFLAGS) $(EXTRACPPFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/platform/leap_transport_nb.o: ../src/platform/leap_transport_nb.cpp
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C++ Compiler'
	arm-unknown-eabi-g++ $(GW_APP_CXX_BASE) $(CXXFLAGS) $(CPPFLAGS) $(EXTRACPPFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/gateway_leap_session.o: $(GW_SHARED)/gateway_leap_session.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	arm-unknown-eabi-gcc $(GW_APP_C_BASE) $(CFLAGS) $(CPPFLAGS) $(EXTRACFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '
