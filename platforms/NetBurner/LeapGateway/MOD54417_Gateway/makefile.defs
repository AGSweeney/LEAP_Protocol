HTMLDIR = ../html
OBJDIR = nblibs
TARGET = $(OBJDIR)/libnetburner.a
TARGET_TYPE = lib
LOCAL_OVERLOAD_DIR = ../overload
NBALL = nball
NBCLEAN = nbclean

OPENER_LIB = ../opener/build-work/libopener_netburner.a
LEAP_GW_LIB = ../leap/build-work/libleap_gateway_netburner.a
LIBS += $(OPENER_LIB) $(LEAP_GW_LIB)

GW_PLATFORM = ../src/platform
GW_SHARED = ../../../../x86-32/D945GSEJT/LeapGateway/src
LEAP_CORE = ../../../../../leap_core

EXTRACPPFLAGS += -I$(GW_PLATFORM) -I$(GW_PLATFORM)/generated -I$(GW_SHARED) -I$(LEAP_CORE)/inc -I../opener/netburner_port -I../src -DNETBURNER_GATEWAY=1 -DLEAP_GATEWAY_OPENER_ENABLE=1
EXTRACFLAGS += -I$(GW_PLATFORM) -I$(GW_PLATFORM)/generated -I$(GW_SHARED) -I$(LEAP_CORE)/inc -I../opener/netburner_port -I../src -DNETBURNER_GATEWAY=1 -DLEAP_GATEWAY_OPENER_ENABLE=1

nbfind = $(foreach x,$(wildcard $1*),$(call nbfind,$x/,$2)$(filter $(subst *,%,$2),$x))
COMPHTML_SRCS := $(call nbfind,$(HTMLDIR)/,*.htm *.html *.HTM *.HTML *.Htm *.Html *.js *.Js *.JS *.css *.CSS *.Css *.jpg *.jpeg *.gif *.png)
ifneq ($(COMPHTML_SRCS),)
	OBJS += htmldata.o
	C_UPPER_DEPS += htmldata.cpp
endif

include $(NNDK_ROOT)/make/boilerplate.mk

# leap_gateway_opener.c was removed from src/; it is linked via libleap_gateway_netburner.a.
# Eclipse may still emit it in auto-generated subdir.mk until the project is refreshed.
C_SRCS := $(filter-out ../src/leap_gateway_opener.c,$(C_SRCS))
OBJS := $(filter-out ./src/leap_gateway_opener.o,$(OBJS))
C_DEPS := $(filter-out ./src/leap_gateway_opener.d,$(C_DEPS))

# LEAP L2 transport must be a firmware object (CustomNetDoRX), not only in the static lib.
GW_TRANSPORT_CPP := ../src/platform/leap_transport_nb.cpp
GW_TRANSPORT_OBJ := ./src/platform/leap_transport_nb.o
ifneq ($(filter $(GW_TRANSPORT_CPP),$(CPP_SRCS)),$(GW_TRANSPORT_CPP))
CPP_SRCS += $(GW_TRANSPORT_CPP)
endif
ifneq ($(filter $(GW_TRANSPORT_OBJ),$(OBJS)),$(GW_TRANSPORT_OBJ))
OBJS += $(GW_TRANSPORT_OBJ)
endif

# Keep the shared session state machine in the firmware build proper. The same
# object also exists in libleap_gateway_netburner.a, but linking this object
# first prevents stale archive members from masking source changes.
GW_SESSION_C := $(GW_SHARED)/gateway_leap_session.c
GW_SESSION_OBJ := ./src/gateway_leap_session.o
ifneq ($(filter $(GW_SESSION_C),$(C_SRCS)),$(GW_SESSION_C))
C_SRCS += $(GW_SESSION_C)
endif
ifneq ($(filter $(GW_SESSION_OBJ),$(OBJS)),$(GW_SESSION_OBJ))
OBJS += $(GW_SESSION_OBJ)
endif
