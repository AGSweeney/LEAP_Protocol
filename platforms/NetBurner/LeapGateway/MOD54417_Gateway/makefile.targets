ifeq ($(MKNBLIBS),1)
all: $(TARGET)
$(ELF): $(TARGET)
endif

ifeq ($(NBDEBUG),1)
$(TARGET): $(DBLIB_OBJ_FILES)
else
$(TARGET): $(LIB_OBJ_FILES)
endif
	$(RM) $@
	$(call max_args,$(AR) cr $@ ,10,$^)

.PHONY: clean-nblibs load-nbimage app-s19 opener-clean-deps

opener-clean-deps:
	-$(RM) ./src/opener/leap_gateway_eip.d ./src/opener/leapgateway.d ./src/opener/networkconfig.d ./src/opener/opener.d

clean: opener-clean-deps

clean-nblibs: opener-clean-deps
	$(RM) $(OBJDIR)

$(LEAP_GW_LIB): $(LEAP_GW_LIB_INPUTS)
	@echo 'Building LEAP Gateway NetBurner static library: $@'
	powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../build-leap-gateway-netburner.ps1

# Legacy AutoUpdate image (*_APP.s19) for MOD5441x first-time flash. Run from Release after build.
ifneq ($(strip $(BUILD_ARTIFACT_NAME)),)
app-s19: $(BUILD_ARTIFACT_NAME).s19
	@echo 'Building AutoUpdate image: $(BUILD_ARTIFACT_NAME)_APP.s19'
	compcode $< $(BUILD_ARTIFACT_NAME)_APP.s19 0xC0040000 0xC1FC0000 -PMOD5441X -R -M $(BUILD_ARTIFACT_NAME).map
endif

load-nbimage:
	@echo "Sending $(NBIMAGE) to $(DEVIP)"
	$(APPUPDATE) -q -O- --post-file=$(NBIMAGE) $(DEVIP):20034/appupdate.htm

htmldata.cpp: $(COMPHTML_SRCS)
	comphtml $(HTMLDIR) -o$@

htmldata.o: htmldata.cpp
	$(CXX) -c -I"../src" $(CXXFLAGS) $(CPPFLAGS) $< -o $@

ifneq ($(wildcard $(OBJDIR)/.stale),)
clean: clean-nblibs
endif

ifneq ($(strip $(ELF)),)
.SECONDEXPANSION:
ELF1 := $(firstword $(ELF))
TIMESTAMP_SRC = "extern const char LinkTime[]; const char LinkTime[] = \"`date -u +"%Y-%m-%dT%H:%M:%SZ"`\";"
LINKSTAMP_OBJ := $(dir $(ELF1))$(notdir $(basename $(ELF1)))_linkDTStamp.o
USER_OBJS += $(LINKSTAMP_OBJ)
$(ELF1): $(LINKSTAMP_OBJ)

$(LINKSTAMP_OBJ): $$(filter-out $$(LINKSTAMP_OBJ),$$(OBJS) $$(USER_OBJS)) $$(LIBS) makefile objects.mk sources.mk subdir.mk
	@echo "Time stamping $@"
	@mkdir -p $(dir $@)
	@echo $(TIMESTAMP_SRC) | $(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ -xc++ -c -
endif

# Eclipse-generated subdir.mk compile lines omit LEAP gateway include paths.
# Explicit rules here override those pattern rules (included last via Release/makefile).
GW_APP_CXX_BASE := -std=gnu++17 -O2 -Wall -c -fmessage-length=0 -fdata-sections -ffunction-sections \
	-gdwarf-2 -fno-exceptions -fno-rtti -Wno-write-strings -fno-omit-frame-pointer \
	-falign-functions=4 -fasynchronous-unwind-tables -mcpu=54415 -DMOD5441X -DMCF5441X -DCOLDFIRE

GW_APP_C_BASE := -std=gnu11 -O2 -Wall -c -fmessage-length=0 -fdata-sections -ffunction-sections \
	-gdwarf-2 -Wno-write-strings -fno-omit-frame-pointer \
	-falign-functions=4 -fasynchronous-unwind-tables -mcpu=54415 -DMOD5441X -DMCF5441X -DCOLDFIRE

GW_ARM_ONLY_FLAGS := -mcpu=cortex-m7 -DMODM7AE70 -DSAME70 -DCORTEX_M7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=softfp
GW_APP_CPPFLAGS := $(filter-out $(GW_ARM_ONLY_FLAGS),$(CPPFLAGS))
GW_APP_CXXFLAGS := $(filter-out $(GW_ARM_ONLY_FLAGS),$(CXXFLAGS))
GW_APP_CFLAGS := $(filter-out $(GW_ARM_ONLY_FLAGS),$(CFLAGS))

./src/main.o: ../src/main.cpp
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C++ Compiler'
	m68k-unknown-elf-g++ $(GW_APP_CXX_BASE) $(GW_APP_CXXFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACPPFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/platform/leap_transport_nb.o: ../src/platform/leap_transport_nb.cpp
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C++ Compiler'
	m68k-unknown-elf-g++ $(GW_APP_CXX_BASE) $(GW_APP_CXXFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACPPFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/gateway_leap_session.o: $(GW_SHARED)/gateway_leap_session.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-gcc $(GW_APP_C_BASE) $(GW_APP_CFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/opener/opener.o: ../src/opener/opener.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-gcc $(GW_APP_C_BASE) $(GW_APP_CFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACFLAGS) $(OPENER_CPPFLAGS) -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/opener/networkconfig.o: ../src/opener/networkconfig.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-gcc $(GW_APP_C_BASE) $(GW_APP_CFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACFLAGS) $(OPENER_CPPFLAGS) -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/opener/leapgateway.o: ../src/opener/leapgateway.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-gcc $(GW_APP_C_BASE) $(GW_APP_CFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACFLAGS) $(OPENER_CPPFLAGS) -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/opener/leap_gateway_eip.o: ../src/opener/leap_gateway_eip.c
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-gcc $(GW_APP_C_BASE) $(GW_APP_CFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACFLAGS) $(OPENER_CPPFLAGS) -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

./src/opener/nb_reboot.o: ../opener/netburner_port/nb_reboot.cpp
	@echo 'Building file: $<'
	@echo 'Invoking: GNU C++ Compiler'
	@mkdir -p $(dir $@)
	m68k-unknown-elf-g++ $(GW_APP_CXX_BASE) $(GW_APP_CXXFLAGS) $(GW_APP_CPPFLAGS) $(EXTRACPPFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

include ../opener/netburner_port/nbeclipse-link.mk
