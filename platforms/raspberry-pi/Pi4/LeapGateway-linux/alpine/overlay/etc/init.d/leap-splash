#!/sbin/openrc-run

name="leap-splash"
description="Show LeapOS-Gateway boot splash on the local console"

depend() {
	need root
	before leap-growfs leap-gateway
}

start() {
	local tty="/dev/tty1"

	[ -w "$tty" ] || return 0

	{
		printf '\033[2J\033[H'
		printf '\033[1;36m'
		printf '  _                     ___  ____\n'
		printf ' | |    ___  __ _ _ __ / _ \\/ ___|\n'
		printf ' | |   / _ \\/ _` | '"'"'_ \\ | | \\___ \\\n'
		printf ' | |__|  __/ (_| | |_) | |_| |___) |\n'
		printf ' |_____\\___|\\__,_| .__/ \\___/|____/\n'
		printf '                 |_|\n'
		printf '\033[0m\n'
		printf '  LeapOS-Gateway for Raspberry Pi 4\n'
		printf '  LEAP / EtherNet/IP Bridge\n\n'
		printf '  Web UI: http://192.168.1.3:8080\n'
		printf '  Console: root (no password)\n\n'
	} > "$tty"

	return 0
}
