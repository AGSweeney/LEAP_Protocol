/* LEAP Conformance Studio — dark industrial theme (Win32UI family) */

QWidget {
    background-color: #2b2b2b;
    color: #e8e8e8;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

#StudioTabs::pane {
    border: 1px solid #1e1e1e;
    background-color: #2b2b2b;
    top: -1px;
}

#StudioTabs QTabBar::tab {
    background-color: #353535;
    border: 1px solid #1e1e1e;
    padding: 8px 16px;
    margin-right: 2px;
}

#StudioTabs QTabBar::tab:selected {
    background-color: #3d5a80;
}

QGroupBox {
    border: 1px solid #1e1e1e;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

#ToolbarButton {
    background-color: #484848;
    border: 1px solid #1e1e1e;
    border-radius: 2px;
    padding: 6px 12px;
    min-width: 72px;
}

#ToolbarButton:hover {
    background-color: #525252;
}

#ToolbarButton:pressed {
    background-color: #3a6a9a;
}

QStatusBar {
    background-color: #353535;
    color: #e8e8e8;
}

QProgressBar {
    border: 1px solid #1e1e1e;
    background-color: #3a3a3a;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3d5a80;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #3a3a3a;
    border: 1px solid #1e1e1e;
    padding: 4px;
    selection-background-color: #3d5a80;
}

QTableWidget, QTreeWidget {
    background-color: #484848;
    alternate-background-color: #525252;
    gridline-color: #1e1e1e;
}

QHeaderView::section {
    background-color: #353535;
    color: #e8e8e8;
    padding: 4px;
    border: 1px solid #1e1e1e;
}

QSplitter::handle:horizontal {
    background: #1e1e1e;
    width: 3px;
}

QSplitter::handle:vertical {
    background: #1e1e1e;
    height: 3px;
}

#DiagnosticsSplitter::handle:horizontal {
    background: #4a4a4a;
    width: 6px;
    margin: 6px 0;
}

#DeviceStatusPanel,
#LatencyAnalysisPanel {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    margin-top: 2px;
    padding-top: 10px;
    background-color: #353535;
}

#OutputLog {
    font-family: Consolas;
    font-size: 11px;
    background-color: #282828;
    color: #d8d8d8;
}
