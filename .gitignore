# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Build outputs (local only — see docs/BUILD.md)
build*/
out/
dist/*
!dist/LEAP_Conformance_Studio_*_x64_Setup.exe
bin/
obj/
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
!dist/LEAP_Conformance_Studio_*_x64_Setup.exe

# Generated disk / VM images
*.img
*.iso
*.raw
*.qcow2
*.vhd
*.vhdx
*.vmdk

# Accidental raw image outputs from failed shell/build invocations
/;
/BIOS_BOOT_START=2048

# Python tooling (for scripts/utilities)
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp
