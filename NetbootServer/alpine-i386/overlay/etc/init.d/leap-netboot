#!/sbin/openrc-run

name="leap-netboot"
description="LeapOS NetBoot management API"
command="/usr/bin/python3"
command_args="/opt/leap-netboot/server/leap_netbootd.py"
command_env="TMPDIR=/var/lib/leap-netboot/incoming/tmp"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/leap-netboot.log"
error_log="/var/log/leap-netboot.log"

depend() {
	need localmount networking leap-netboot-dirs
	before nginx
}

start_pre() {
	rm -f /etc/nginx/http.d/00-body-size.conf
	if [ -x /opt/leap-netboot/scripts/render-pxe.sh ]; then
		/opt/leap-netboot/scripts/render-pxe.sh || true
	fi
}
